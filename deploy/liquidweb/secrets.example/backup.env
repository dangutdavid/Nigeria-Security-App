# Off-site encrypted backups (copy to ../secrets/backup.env).
# Age public key of the RECOVERY keypair. The private key is kept OFFLINE, never on this server.
BACKUP_AGE_RECIPIENT=age1CHANGE_ME
# S3-compatible bucket in a different location from the server (e.g. Liquid Web Object Storage).
BACKUP_S3_URI=s3://nsa-backups/postgres
BACKUP_S3_ENDPOINT=https://objects.liquidweb.services
AWS_ACCESS_KEY_ID=CHANGE_ME
AWS_SECRET_ACCESS_KEY=CHANGE_ME
BACKUP_KEEP_DAYS=35
