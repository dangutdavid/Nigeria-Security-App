# Runtime secrets for the API (copy to ../secrets/api.env, chmod 600).
# Generate random values with:  openssl rand -base64 48   (AUTH_SECRET)
#                               openssl rand -base64 32   (DATA_ENCRYPTION_KEY — exactly 32 bytes)
TRUST_PROXY=1
DATABASE_URL=postgres://nsa_app:CHANGE_ME@postgres:5432/nsa
REDIS_URL=redis://:CHANGE_ME@redis:6379/0
AUTH_SECRET=CHANGE_ME
DATA_ENCRYPTION_KEY=CHANGE_ME
CORS_ALLOWED_ORIGINS=https://admin.example.gov.ng
METRICS_TOKEN=CHANGE_ME
# Two-step verification: enforced for every staff role in production by default.
# MFA_ENFORCED_ROLES=officer,supervisor,commander,admin,super_admin
SMS_PROVIDER=termii
TERMII_API_KEY=CHANGE_ME
TERMII_SENDER_ID=N-Alert
# Evidence object storage (S3-compatible; Liquid Web Object Storage works).
EVIDENCE_S3_BUCKET=nsa-evidence
EVIDENCE_S3_ENDPOINT=https://objects.liquidweb.services
EVIDENCE_S3_REGION=us-east-1
AWS_ACCESS_KEY_ID=CHANGE_ME
AWS_SECRET_ACCESS_KEY=CHANGE_ME
# Observability
SENTRY_DSN=
SENTRY_RELEASE=
BETTER_STACK_SOURCE_TOKEN=
BETTER_STACK_INGEST_HOST=
BETTER_STACK_HEARTBEAT_URL=
# Retention (days) — confirm against agency records schedules
CITIZEN_REPORT_RETENTION_DAYS=2555
NOTIFICATION_RETENTION_DAYS=365
AUDIT_RETENTION_DAYS=2190
