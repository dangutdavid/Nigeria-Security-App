# Nigeria Security App — environment variables
# Copy to .env (or export in your shell) and fill in real values.
# Never commit real secrets.

# ---- API server (artifacts/api-server) --------------------------------------

# REQUIRED in production (min 16 chars). Signs auth tokens and evidence
# download URLs. Without it, development uses an insecure fallback and
# production refuses to start.
AUTH_SECRET=

# Secret rotation (see docs/RUNBOOK.md): set to the OLD secret while rotating
# AUTH_SECRET so live sessions keep verifying; remove after a full 12h TTL.
#AUTH_SECRET_PREVIOUS=

# Demo credentials (FO-001/1234 etc.). Enabled by default outside production;
# DISABLED in production unless explicitly set to true (staging only!).
#ALLOW_DEMO_USERS=false

# Postgres connection string. When unset, the server runs on in-memory stores
# (explicit local-dev fallback — all data resets on restart).
# Apply migrations first: pnpm --filter @workspace/db run migrate
DATABASE_URL=postgres://USER@localhost:5432/nigeria_security

# Port the API server listens on (PORT wins over API_PORT). Default: 8081.
PORT=8081
#API_PORT=8081

# development | production. Production enforces AUTH_SECRET, enables HSTS,
# JSON log output, and stops echoing OTP codes in responses.
NODE_ENV=development

# pino log level (default: info).
#LOG_LEVEL=info

# ---- AI assistant ------------------------------------------------------------

# anthropic (default) | google — selects the assistant provider.
#AI_PROVIDER=anthropic
# Server-side only; the assistant reports itself unavailable without a key.
#ANTHROPIC_API_KEY=
#GEMINI_API_KEY=

# ---- Evidence storage ---------------------------------------------------------

# Directory for uploaded evidence binaries (local-disk storage backend).
# Default: ./data/evidence under the server working directory.
#EVIDENCE_STORAGE_DIR=/var/lib/nigeria-security/evidence

# ---- Push notifications --------------------------------------------------------

# Optional Expo access token for the push API (enhanced security setting in
# the Expo dashboard). Pushes work without it for standard projects.
#EXPO_ACCESS_TOKEN=

# ---- Mobile app (artifacts/mobile, Expo public vars) ---------------------------

# Enable API-first mode in the mobile app.
EXPO_PUBLIC_USE_API=true
# From a phone, use your machine's LAN IP — not localhost.
EXPO_PUBLIC_API_BASE_URL=http://YOUR-LAN-IP:8081/api
