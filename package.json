{
  "name": "workspace",
  "version": "0.0.0",
  "license": "MIT",
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "preinstall": "sh -c 'rm -f package-lock.json yarn.lock; case \"$npm_config_user_agent\" in pnpm/*) ;; *) echo \"Use pnpm instead\" >&2; exit 1 ;; esac'",
    "build": "pnpm run typecheck && pnpm -r --if-present run build",
    "typecheck:libs": "tsc --build",
    "typecheck": "pnpm run typecheck:libs && pnpm -r --filter \"./artifacts/**\" --filter \"./scripts\" --if-present run typecheck",
    "lint": "eslint .",
    "audit:prod": "pnpm audit --prod --audit-level high"
  },
  "private": true,
  "devDependencies": {
    "@eslint/js": "^9",
    "eslint": "^9",
    "eslint-plugin-security": "^3",
    "globals": "^15",
    "prettier": "^3.8.1",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8"
  },
  "pnpm": {
    "overrides": {
      "path-to-regexp": "^8.4.0",
      "ws": "^8.21.0",
      "qs": "^6.15.2",
      "protobufjs": "^7.6.5",
      "body-parser": "^2.3.0",
      "postcss": "^8.5.18",
      "proxy-addr": "^2.0.8",
      "fast-uri@^3": "^3.1.7",
      "brace-expansion@^5": "^5.0.11",
      "brace-expansion@^2": "^2.1.6",
      "brace-expansion@^1": "^1.1.20",
      "js-yaml@^3": "^3.15.2",
      "js-yaml@^4": "^4.3.2",
      "nanoid@^3": "^3.3.18",
      "tar@^7": "^7.5.21",
      "browserslist@^4": "^4.28.7",
      "undici@^6": "^6.28.1",
      "source-map-js@^1": "^1.2.2",
      "compression@^1": "^1.8.2",
      "@xmldom/xmldom@~0.8": "~0.8.15",
      "@xmldom/xmldom@~0.9": "~0.9.12"
    },
    "auditConfig": {
      "ignoreGhsas": [
        "GHSA-c2c7-rcm5-vvqj",
        "GHSA-w7jw-789q-3m8p",
        "GHSA-395f-4hp3-45gv",
        "GHSA-5p2g-fcmc-qvqq",
        "GHSA-w3rx-r6r6-pgpr",
        "GHSA-86w9-cpqp-85rv"
      ]
    }
  }
}
